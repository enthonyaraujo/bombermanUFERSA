{
  "name": "bomberman-sqs-multiplayer",
  "version": "1.0.0",
  "description": "Bomberman multiplayer web 4 jogadores com AWS SQS e ECS",
  "main": "src/backend/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/backend/server.js",
    "worker": "node src/worker/worker.js",
    "start:all": "node -e \"import('./src/backend/server.js'); import('./src/worker/worker.js');\"",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "bomberman",
    "sqs",
    "aws",
    "ecs",
    "multiplayer",
    "websocket",
    "canvas"
  ],
  "author": "Enthony",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.750.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  }
}
